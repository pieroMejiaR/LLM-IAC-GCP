# Copiar a .env y completar. No subir .env al repositorio.

# LLM (LiteLLM lee GEMINI_API_KEY para los modelos gemini/*)
GEMINI_API_KEY=
AGENT_MODELO=gemini/gemini-3.8-flash
# Tarifas en USD por millón de tokens (nivel pagado estándar, vigentes hasta el 31/12/2026)
TARIFA_ENTRADA_USD_M=0.75
TARIFA_SALIDA_USD_M=3.75
AGENT_MAX_TOKENS=32000
# AGENT_TEMPERATURA=        # vacío = valor por defecto del proveedor
MAX_REPARACIONES=5

# GCP
GCP_PROYECTO=
GCP_REGION=southamerica-west1
# Cuenta Viewer para terraform plan en modo evaluación
GCP_CUENTA_EVALUACION=agente-viewer@PROYECTO.iam.gserviceaccount.com
# Cuenta con roles limitados al caso, solo para el modo despliegue
GCP_CUENTA_DESPLIEGUE=agente-deploy@PROYECTO.iam.gserviceaccount.com

# Grounding y controles
ESQUEMA_PROVEEDOR=grounding/esquema_catalogo.json
VERSION_PROVEEDOR=>= 6.0
CHECKOV_BLOQUEANTES=CKV_GCP_2,CKV_GCP_3
# TFLINT_CONFIG=sandbox/.tflint.hcl
